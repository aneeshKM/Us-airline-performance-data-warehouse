# Snowflake connection (never commit a populated .env file)
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=AIRLINE_PERFORMANCE
SNOWFLAKE_WAREHOUSE=AIRLINE_ETL_WH
SNOWFLAKE_ROLE=AIRLINE_ETL_ROLE
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_STAGING_SCHEMA=STAGING
SNOWFLAKE_ANALYTICS_SCHEMA=ANALYTICS
SNOWFLAKE_METADATA_SCHEMA=METADATA
SNOWFLAKE_STAGE=FLIGHT_FILES

# Pipeline defaults
PIPELINE_START_MONTH=2023-01
PIPELINE_END_MONTH=2024-12
RAW_DATA_DIR=/opt/airflow/data/raw
BTS_BASE_URL=https://transtats.bts.gov/PREZIP
REQUEST_TIMEOUT_SECONDS=120

# Local Airflow only. Generate a unique value for any shared environment.
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=change-me-for-any-shared-environment
AIRFLOW_UID=50000

